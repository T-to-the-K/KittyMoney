<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="8dp"
    android:background="@drawable/bg_card_soft"
    android:layout_marginBottom="6dp"
    android:paddingHorizontal="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMemberName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/warm_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvMemberStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/warm_subtext"
            android:textSize="12sp" />

    </LinearLayout>

    <Button
        android:id="@+id/btnShares"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shares"
        android:textColor="@color/warm_primary_dark"
        style="?android:attr/buttonBarButtonStyle" />

    <Button
        android:id="@+id/btnRemoveMember"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Remove"
        android:textColor="@color/warm_red"
        style="?android:attr/buttonBarButtonStyle" />

</LinearLayout>
