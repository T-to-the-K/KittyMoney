<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvBoardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/warm_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rows are members · one column per running kitty · totals and monthly pot below"
            android:textColor="@color/warm_subtext"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TableLayout
                android:id="@+id/boardTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/warm_card"
                android:padding="6dp"
                android:stretchColumns="*" />

        </HorizontalScrollView>

    </LinearLayout>
</ScrollView>