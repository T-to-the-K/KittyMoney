<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/warm_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kitty Money"
            android:textColor="@color/warm_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your savings circle, at a glance"
            android:textSize="14sp"
            android:textColor="@color/warm_subtext"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <Button
        android:id="@+id/btnAdd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/warm_primary"
        android:text="+ New Kitty"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnBoard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/warm_secondary"
        android:text="Open Spreadsheet"
        android:textColor="@color/warm_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No kitties yet.\n\nTap + New Kitty to start one, then\ntap it to track members and cycles.\n\nLong-press a kitty to delete it."
        android:gravity="center"
        android:layout_marginTop="64dp"
        android:textColor="@color/warm_subtext"
        android:textSize="15sp"
        android:layout_weight="1" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false" />

</LinearLayout>
