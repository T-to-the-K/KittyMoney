<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Kitty name (e.g. Family Fund)" />

    <EditText
        android:id="@+id/etTotalAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Monthly pot paid to the collector (optional)"
        android:inputType="numberDecimal"
        android:layout_marginTop="12dp" />

    <EditText
        android:id="@+id/etDuration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Months it runs (optional, auto = one per member/slot)"
        android:inputType="number"
        android:layout_marginTop="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="The collector takes the pot each month (half share = half). Leave blank for free-form."
        android:textSize="12sp"
        android:textColor="@color/warm_subtext" />

</LinearLayout>